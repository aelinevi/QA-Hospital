{
  "version": 2,
  "builds": [
    {
      "src": "scripts/04_qa_backend_gemini.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "scripts/04_qa_backend_gemini.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}